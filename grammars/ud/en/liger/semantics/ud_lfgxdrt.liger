--replace(true);

// UD (Stanza) semantics in LFGxDRT notation: the meaning constructors the lfgxdrt inference
// grammar gives the same sentences (xleplusglue docs/plans/UD_PARSING_PLAN.md, step 3).
//
// Every meaning constructor hangs on a node of its own, reached from the word whose lexical
// material it encodes. That word is its anchor: LiGER numbers the constructors by their
// anchors' positions (UdSourceIndices), as XLE numbers a grammar's constructors by their
// tokens. A determiner's constructor hangs from the determiner, a noun's from the noun, a
// verb's argument constructors from the verb.

// ---- Clauses -------------------------------------------------------------------------
// A clause head -- a verb, or the predicate of a copula -- has a clause node (the scope of
// its quantifiers, #c_t) and a goal node the clause resolves to (XLE's (\P.P) : f_t -o g_t).

#v UPOS VERB ==> #v CLAUSE #c & #c GOAL #g.
#h COP #b ==> #h CLAUSE #c & #c GOAL #g.

#c GOAL #g ==> #g GLUE (\P.P) : (#c_t -o #g_t).

// Scope (as XLE's QUANT-SCOPE, by inside-out functional uncertainty): a noun phrase can scope
// at the clause of any clause head it is embedded in, along argument, modifier and clausal
// relations. Step 1 states every site; step 2 has each noun phrase choose one, independently
// of the others (?*=>: one branch per combination).
EMB := NSUBJ | NSUBJ:PASS | OBJ | IOBJ | OBL | OBL:AGENT | NMOD | CCOMP | XCOMP | ADVCL | ACL | ACL:RELCL .

// Names, definite descriptions and personal pronouns stay in situ (XLE's NAME-SCOPE): below.
#n UPOS PROPN & -(#n DET #d) ==> #n IN-SITU true.
#n DET #d & #d LEMMA the ==> #n IN-SITU true.
#n UPOS PRON & #n PRONTYPE Prs ==> #n IN-SITU true.

#n UPOS NOUN & -(#n IN-SITU true) & #n ^(@EMB*) #v & #v CLAUSE #c ==> #n SCOPE-SITE #c.
#n UPOS PROPN & -(#n IN-SITU true) & #n DET #d & #n ^(@EMB*) #v & #v CLAUSE #c ==> #n SCOPE-SITE #c.

#n SCOPE-SITE #c & -(#n SCOPE #x) ?*=> #n SCOPE #c.

// What stays in situ scopes locally: at the closest tense-marked clause it is embedded in
// (finite head, or a finite auxiliary or copula), e.g. a name in "Kim believes that Mia left".

#v CLAUSE #c & #v VERBFORM Fin ==> #v TAM-CLAUSE #c.
#v CLAUSE #c & #v AUX #a & #a VERBFORM Fin ==> #v TAM-CLAUSE #c.
#v CLAUSE #c & #v COP #a & #a VERBFORM Fin ==> #v TAM-CLAUSE #c.

#n IN-SITU true & #n ^(@EMB*) #v & #v TAM-CLAUSE #c &
-(#n ^(@EMB*) #u ^(@EMB+) #v & #u TAM-CLAUSE #x) ==> #n SCOPE #c.

// ---- Events ----------------------------------------------------------------------------

#v UPOS VERB & #v LEMMA %l ==> #v EV #e & #e GLUE (\v.([],[%l(v)])) : (#e_v -o #e_t).
#h COP #b & #b LEMMA %l ==> #b EV #e & #e GLUE (\v.([],[%l(v)])) : (#e_v -o #e_t).

#v EV #e & #v CLAUSE #c ==> #e CLOSURE #m & #m GLUE (\V.([e:v],[])+V@e) : ((#e_v -o #e_t) -o #c_t).
#h COP #b EV #e & #h CLAUSE #c ==> #e CLOSURE #m & #m GLUE (\V.([e:v],[])+V@e) : ((#e_v -o #e_t) -o #c_t).

// Arguments: arg1 the subject (the agent of a passive), arg2 the object (the subject of a
// passive, the predicate nominal of a copula).
#v NSUBJ #n & #v EV #e ==> #e ARG1 #m &
#m GLUE (\V.(\x.(\e.(V@e+([],[arg1(e,x)]))))) : ((#e_v -o #e_t) -o (#n_e -o (#e_v -o #e_t))) || noscope.
#v OBL:AGENT #n & #v EV #e ==> #e ARG1 #m &
#m GLUE (\V.(\x.(\e.(V@e+([],[arg1(e,x)]))))) : ((#e_v -o #e_t) -o (#n_e -o (#e_v -o #e_t))) || noscope.
#v OBJ #n & #v EV #e ==> #e ARG2 #m &
#m GLUE (\V.(\x.(\e.(V@e+([],[arg2(e,x)]))))) : ((#e_v -o #e_t) -o (#n_e -o (#e_v -o #e_t))) || noscope.
#v NSUBJ:PASS #n & #v EV #e ==> #e ARG2 #m &
#m GLUE (\V.(\x.(\e.(V@e+([],[arg2(e,x)]))))) : ((#e_v -o #e_t) -o (#n_e -o (#e_v -o #e_t))) || noscope.

#h COP #b EV #e & #h NSUBJ #n ==> #e ARG1 #m &
#m GLUE (\V.(\x.(\e.(V@e+([],[arg1(e,x)]))))) : ((#e_v -o #e_t) -o (#n_e -o (#e_v -o #e_t))) || noscope.
#h COP #b EV #e & #h UPOS NOUN ==> #e ARG2 #m &
#m GLUE (\V.(\x.(\e.(V@e+([],[arg2(e,x)]))))) : ((#e_v -o #e_t) -o (#h_e -o (#e_v -o #e_t))) || noscope.
#h COP #b EV #e & #h UPOS PROPN ==> #e ARG2 #m &
#m GLUE (\V.(\x.(\e.(V@e+([],[arg2(e,x)]))))) : ((#e_v -o #e_t) -o (#h_e -o (#e_v -o #e_t))) || noscope.

// An adjectival predicate holds of the event (XLE: crazy(x) : f_v -o f_t, added to be(v)).
#h COP #b EV #e & #h UPOS ADJ & #h LEMMA %l ==> #h PRED-SEM #p &
#p GLUE (\x.([],[%l(x)])) : (#p_v -o #p_t) & #p MOD #m &
#m GLUE (\Q.(\R.(\x.(Q@x+R@x)))) : ((#p_v -o #p_t) -o ((#e_v -o #e_t) -o (#e_v -o #e_t))) || noscope.

// ---- Adjectives ----------------------------------------------------------------------------
// Degree (gradable) adjectives: the lfgxdrt grammar's lexicon (lexica/adj_adv_lex_fracas,
// SEMTYPE degree). Any other adjective is intersective, as one the grammar does not list.
#a UPOS ADJ & #a LEMMA big ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA clever ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA fast ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA fat ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA important ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA large ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA small ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA successful ==> #a SEMTYPE degree.
#a UPOS ADJ & #a LEMMA warm ==> #a SEMTYPE degree.

// An attributive adjective ("black dog") adds its predicate to the noun's (XLE's DEFAULT-ADJ-SEM).
#n AMOD #a & #a LEMMA %l ==> #a ADJ-SEM #p &
#p GLUE (\x.([],[%l(x)])) : (#p_e -o #p_t) & #p MOD #m &
#m GLUE (\Q.(\R.(\x.(Q@x+R@x)))) : ((#p_e -o #p_t) -o ((#n_e -o #n_t) -o (#n_e -o #n_t))) || noscope.

// A degree adjective relates its holder to a degree above the threshold of the noun (attributive,
// "big cat": th_big('cat')) or of the copula (predicative: th_fast('be')): the lfgxdrt grammar's
// degree rules (liger/semantics/degree_rules_lfgxdrt.liger), positive uses.
#n AMOD #a & #a SEMTYPE degree & #a LEMMA %l & #a ADJ-SEM #p & #n LEMMA %x ==>
#p DEGREE #d & #d POSITIVE #o & #o GLUE (\P.([d:d],[]) + ([],[d > th_%l('%x')]) + P@d) : ((#d_d -o #n_t) -o #n_t) || noscope &
#p DEGREE-PRED #q & #q GLUE (\P.(\d.(\x.([],[%l(x,d)])))) : ((#p_e -o #p_t) -o (#d_d -o (#p_e -o #p_t))).

#h COP #b EV #e & #h SEMTYPE degree & #h LEMMA %l & #h PRED-SEM #p ==>
#p DEGREE #d & #p DEGREE-PRED #q & #q GLUE (\P.(\d.(\x.([],[%l(x,d)])))) : ((#p_v -o #p_t) -o (#d_d -o (#p_v -o #p_t))).

#h COP #b EV #e & #h LEMMA %l & #h PRED-SEM #p DEGREE #d & #b LEMMA %x & -(#h DEGREE Cmp) ==>
#d POSITIVE #o & #o GLUE (\P.([d:d],[]) + ([],[d > th_%l('%x')]) + P@d) : ((#d_d -o #e_t) -o #e_t) || noscope.

// A comparative ("Peter is faster than Sue"): the holder's degree d, and the compared phrase's
// event, with a degree and an event of its own, does not reach d (XLE's comparative rule for
// predicative uses; its threshold-free degree replaces the positive's). The compared phrase is
// "than"'s noun; its constructors hang from "than".
#h COP #b EV #e & #h DEGREE Cmp & #h PRED-SEM #p DEGREE #d & #h OBL #s & #s CASE #t & #t LEMMA than ==>
#t CMP-DEGREE #x & #t CMP-EVENT #y & #t CMP-CLAUSE #m.

#h COP #b EV #e & #h LEMMA %l & #h PRED-SEM #p DEGREE #d & #h OBL #s & #s CASE #t &
#t CMP-DEGREE #x & #t CMP-EVENT #y & #t CMP-CLAUSE #m ==>
#t CMP-SEM #q & #q GLUE (\P.(\Q.(\e.([d:d],[]) + P@d@e + ([],[~(([v],[]) + Q@d@v)])))) :
((#d_d -o (#p_v -o #p_t)) -o ((#x_d -o (#y_v -o #m_t)) -o (#p_v -o #p_t))) || noscope &
#t CMP-PRED #r & #r GLUE (\d.(\e.([],[%l(e,d)]))) : (#x_d -o (#y_v -o #m_t)) &
#t CMP-ARG #u & #u GLUE (\V.(\x.(\e.(V@e + ([],[arg1(e,x)]))))) : ((#y_v -o #m_t) -o (#s_e -o (#y_v -o #m_t))) || noscope.

// ---- Nouns and determiners ---------------------------------------------------------------
// A common noun: a NOUN, or a PROPN with a determiner ("a Swede"). A name: a PROPN with
// neither a determiner nor a head it is a compound of.

#n UPOS NOUN & #n LEMMA %l ==> #n NOUN-SEM #s & #s GLUE (\x.([],[%l(x)])) : (#n_e -o #n_t).
#n UPOS PROPN & #n DET #d & #n LEMMA %l ==> #n NOUN-SEM #s & #s GLUE (\x.([],[%l(x)])) : (#n_e -o #n_t).

#n UPOS PROPN & #n LEMMA %l & #n SCOPE #c & -(#n DET #d) ==>
#n NAME-SEM #s & #s GLUE (\x.([],[x='%l'])) : (#n_e -o #n_t) &
#n DEF-SEM #q & #q GLUE (\P.(\Q.p(([x],[bind(x)])+P@x)+Q@x)) : ((#n_e -o #n_t) -o ((#n_e -o #c_t) -o #c_t)) || insitu.

// A personal pronoun: an indefinite with ant(x) and its gender, in situ (XLE's PRON-SEM-GEND;
// "it", without a gender, PRON-SEM).
#n UPOS PRON & #n PRONTYPE Prs & #n SCOPE #c ==> #n PRON-Q #q &
#q GLUE (\P.(\Q.([x],[])+P@x+Q@x)) : ((#n_e -o #n_t) -o ((#n_e -o #c_t) -o #c_t)) || insitu.
#n UPOS PRON & #n PRONTYPE Prs & #n GENDER Masc ==> #n PRON-SEM #s &
#s GLUE (\x.([],[ant(x),male(x)])) : (#n_e -o #n_t).
#n UPOS PRON & #n PRONTYPE Prs & #n GENDER Fem ==> #n PRON-SEM #s &
#s GLUE (\x.([],[ant(x),female(x)])) : (#n_e -o #n_t).
#n UPOS PRON & #n PRONTYPE Prs & -(#n GENDER Masc) & -(#n GENDER Fem) ==> #n PRON-SEM #s &
#s GLUE (\x.([],[ant(x)])) : (#n_e -o #n_t).

// A prepositional modifier of a noun ("a boxer with an injury"): the preposition relates
// the two, and a combinator adds that to what the head noun says (XLE's two MCs of "with").
#m NMOD #n & #n CASE #p & #p LEMMA %l ==> #p PP-SEM #s &
#s GLUE (\U.(\V.(\e.(U@e+V@e)))) : ((#m_e -o #p_t) -o ((#m_e -o #m_t) -o (#m_e -o #m_t))) || noscope &
#p REL-SEM #r & #r GLUE (\y.(\x.([],[%l(x,y)]))) : (#n_e -o (#m_e -o #p_t)).

// A compound modifier ("Nobel prize"): a kind of what the head names.
#n COMPOUND #m & #m LEMMA %l ==> #m MOD-SEM #s &
#s GLUE (\P.(\x.([],[kind('%l',x)]) + P@x)) : ((#n_e -o #n_t) -o (#n_e -o #n_t)) || noscope.

#n DET #d & #d LEMMA a & #n SCOPE #c ==> #d DET-SEM #s &
#s GLUE (\P.(\Q.([x],[])+P@x+Q@x)) : ((#n_e -o #n_t) -o ((#n_e -o #c_t) -o #c_t)).
#n DET #d & #d LEMMA every & #n SCOPE #c ==> #d DET-SEM #s &
#s GLUE (\P.(\Q.([],[([x],[])+P@x->Q@x]))) : ((#n_e -o #n_t) -o ((#n_e -o #c_t) -o #c_t)).
#n DET #d & #d LEMMA all & #n SCOPE #c ==> #d DET-SEM #s &
#s GLUE (\P.(\Q.([],[([x],[])+P@x->Q@x]))) : ((#n_e -o #n_t) -o ((#n_e -o #c_t) -o #c_t)).
#n DET #d & #d LEMMA the & #n SCOPE #c ==> #d DET-SEM #s &
#s GLUE (\P.(\Q.p(([x],[bind(x)])+P@x)+Q@x)) : ((#n_e -o #n_t) -o ((#n_e -o #c_t) -o #c_t)) || insitu.
#n DET #d & #d LEMMA no & #n SCOPE #c ==> #d DET-SEM #s &
#s GLUE (\P.(\Q.([],[~(([x],[])+P@x+Q@x)]))) : ((#n_e -o #n_t) -o ((#n_e -o #c_t) -o #c_t)).

// ---- Clause operators ----------------------------------------------------------------------

// Negation of the clause ("not", "did not").
#h ADVMOD #n & #n LEMMA not & #h CLAUSE #c ==> #n NEG-SEM #s &
#s GLUE (\P.([],[~(P)])) : (#c_t -o #c_t).

// A conditional: "if" relates the goals of its clause and of the clause it modifies.
// (Node variables are one letter.)
#m ADVCL #a & #a MARK #i & #i LEMMA if & #m CLAUSE #c GOAL #g & #a CLAUSE #p GOAL #q ==>
#i COND-SEM #s & #s GLUE (\P.(\Q.([],[P->Q]))) : (#q_t -o (#g_t -o #g_t)).
