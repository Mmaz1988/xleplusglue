"
  LFGxDRT adaptation note:

  These FRACAS templates are converted from Prolog-style DRT constructors
  (lam/app/merge/drs/pred/rel/eq) to the LFGxDRT literal notation used by
  glue-basic-drt.lfg.glue.
"

GLUE   BASIC   TEMPLATES (1.0)

   LLIMP(N L R) = (N ANT) = L
	  (N CONS) = R.

   LLATOM(N L T) = (N RESOURCE) = L
	  (N TYPE) = T.

   LLCLOSURE(G) = G $ (g::* GLUE).

   GLUE-MEANING(R M) =
	  (R MEANING) = M.

  NOSCOPE(G) = (G NOSCOPE) = +.
  INSITU(G) = (G INSITU) = +.

   NAME-SCOPE(UP NAME) =
   %name = ({SUBJ | OBJ | OBJ2 | XCOMP | COMP | OBL-TO | OBL-AG | OBL | OBL-COMP | ADJUNCT | PREDLINK | OBL-PART | $}+ ^)
   (%name TNS-ASP TENSE)
   "(%name ROOT) =c +"
   NAME  = s::%name.

   QUANT-SCOPE(UP NAME) =
   %name = ({SUBJ | OBJ | OBJ2 | XCOMP | COMP | OBL-TO | OBL-AG | OBL-COMP | OBL | PREDLINK | ADJUNCT | OBL-PART | $}+ ^) "PREDLINK added so determiners are compatible eg. 'Mary is a dog'"
   (s::%name EV TYPE) =c eventuality
   NAME = s::%name.

" Why does the below not work?
   QUANT-SCOPE(UP NAME) =
	  NAME = s::({SUBJ | OBJ | OBJ2 | XCOMP | OBL-TO | OBL-AG | OBL | ADJUNCT | PREDLINK}+ ^)
	  (NAME EV TYPE) =c eventuality
	  (s::^ QUANT-SCOPE) = (NAME SIT).
	  "

"
   ATTITUDE = (s::^ SIT) = %s
   	      (s::^ EV TYPE) = eventuality.
"

"In principle, the identity function is not necessary but it makes interaction with LiGER simpler"

   EVENT(REL) =
	  (s::^ EV TYPE) = eventuality
	  (s::^ SIT) = %sit
	  :$ (\P.P) : (s::^_t -o %sit_t),
	  :$ (\v.([],[REL(v)])) : ((s::^ EV)_v -o (s::^ EV)_t),
	  :$ (\V.([e],[]) + V@e) : (((s::^ EV)_v -o (s::^ EV)_t) -o s::^_t).

   PREP-SEM(P) =
             {
	     %scope = (s::({ADJUNCT | PREDLINK} ^) EV)
	     (%scope TYPE) =c eventuality
	    :$ (\U.(\V.(\e.(U@e + V@e)))) :
	    ((%scope_v -o s::^_t) -o ((%scope_v -o %scope_t) -o (%scope_v -o %scope_t))),
	    :$ (\y.(\x.([],[P(x,y)]))) : (s::(^OBJ)_e -o (%scope_v -o s::^_t)),
	    |
	    %scope = s::(ADJUNCT ^)
	    (%scope TYPE) =c entity
	    (s::^ EV TYPE) = eventuality "having something is a state -> eventuality variable"
	    :$ (\U.(\V.(\e.(U@e + V@e)))) :
	    ((%scope_e -o s::^_t) -o ((%scope_e -o %scope_t) -o (%scope_e -o %scope_t))) || noscope,
	    :$ (\y.(\x.([],[P(x,y)]))) : (s::(^OBJ)_e -o (%scope_e -o s::^_t)),
	     }.

"
 TENSE-CLOSURE = %tense = (s::^ TEMP-REF EVAL)
 :$ (\P.([t],[t=now]) + P@t) : ((%tense_s -o %tense_t) -o s::^_t).
"

   "Templates for argument structure. Need to be separate to avoid trouble with local names"
   ARG1(ARG) =
       :$ (\V.(\x.(\e.(V@e + ([],[arg1(e,x)]))))) :
       (((s::^ EV)_v -o (s::^ EV)_t) -o (s::ARG_e -o ((s::^ EV)_v -o (s::^ EV)_t))) || noscope.

   ARG2(ARG) =
       :$ (\V.(\x.(\e.(V@e + ([],[arg2(e,x)]))))) :
       (((s::^ EV)_v -o (s::^ EV)_t) -o (s::ARG_e -o ((s::^ EV)_v -o (s::^ EV)_t))) || noscope.

   ARG3(ARG) =
       :$ (\V.(\x.(\e.(V@e + ([],[arg3(e,x)]))))) :
       (((s::^ EV)_v -o (s::^ EV)_t) -o (s::ARG_e -o ((s::^ EV)_v -o (s::^ EV)_t))) || noscope.


DEFAULT-NOUN-SEM(P) =         @(PRED P)
                      	      "(s::^ TYPE) = entity"
                      		  { (^ NTYPE NSYN) =c common
                      		  @(COUNT-NOUN-SEM P)
                      		  |
                      		  (^ NTYPE NSYN) =c proper
                      		  @(PROPER-NOUN-SEM P)
                      		  @DEF-NAME
                      		  }.


COUNT-NOUN-SEM(P) =
                    (s::^ TYPE) = entity
                    :$ (\x.([],[P(x)])) : (s::^_e -o s::^_t).

PROPER-NOUN-SEM(P) = (s::^ TYPE) = entity
                             :$ (\x.([],[x='P'])) : (s::^_e -o s::^_t).

DEF-NAME = @(NAME-SCOPE ^ %n)
              :$ (\Q.(\R.([x],[]) + Q@x + R@x)) :
              ((s::^_e -o s::^_t) -o ((s::^_e -o %n_t) -o %n_t)) || insitu.


DEFAULT-ADJ-SEM(P)  = @(PRED P)
                       {
                      (^ ATYPE) =c attributive
                      s::(ADJUNCT $ ^) = %s
                      :$ (\x.([],[P(x)])) : (s::^_e -o s::^_t),
                      :$ (\Q.(\R.(\x.(Q@x + R@x)))) :
                                ((s::^_e -o s::^_t) -o ((%s_e -o %s_t) -o (%s_e -o %s_t))) || noscope,
                     |
                      (^ ATYPE) =c predicative
                      (s::(PREDLINK ^) EV) = %s
                      :$ (\x.([],[P(x)])) : (s::^_v -o s::^_t),
                      :$ (\Q.(\R.(\x.(Q@x + R@x)))) :
                                ((s::^_v -o s::^_t) -o ((%s_v -o %s_t) -o (%s_v -o %s_t))) || noscope,
                      }.

DEFAULT-EX-QUANT = @(QUANT-SCOPE ^ %q)
                :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
	      ((s::^_e -o s::^_t) -o ((s::^_e -o %q_t) -o %q_t)).

DEFAULT-EX-QUANT-NOSCOPE = @(QUANT-SCOPE ^ %q)
            :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
	      ((s::^_e -o s::^_t) -o ((s::^_e -o %q_t) -o %q_t)) || noscope.

UNIVERSAL-QUANT = @(QUANT-SCOPE ^ %q)
	      :$ (\P.(\Q.([],[([x],[]) + P@x -> Q@x]))) :
	      ((s::^_e -o s::^_t) -o ((s::^_e -o %q_t) -o %q_t)).

DEFAULT-PRON-NOSCOPE(G) = @(QUANT-SCOPE ^ %q)
            (s::^ TYPE) = entity
            :$ (\P.alfa(pro,([x],[G(x)]),P@x)) :
	        ((s::^_e -o %q_t) -o %q_t) || noscope.


