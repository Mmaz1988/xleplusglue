FUNCTION ENGLISH LEXICON (1.0)
"complementizers"

that  C * (^COMP-FORM) = that.

as        CComp * (^PRED) = 'as<(^OBJ)>'
                  (^DEGREE) ~=c comparative
                  (^DEGREE) ~=c superlative;
          ADVComp * (^PRED) = 'as<(^OBL-COMP)>'
                  (^DEGREE) ~=c comparative
                  (^DEGREE) ~=c superlative.
"comparison constructions"

than      CComp * (^PRED) = 'than<(^OBJ)>'
                  ((OBL-COMP ^) DEGREE) =c comparative.

, 	  COMMA * .



"conjunctions"

and 	  CONJ * @(COORD-FORM %stem);
	  CONJnp * @(COORD-FORM %stem) @(NUM pl).

or 	  CONJ * @(COORD-FORM %stem);
	  CONJnp * @(COORD-FORM %stem) @(NUM pl).


"conditionals"

if CONJsub * (^ PRED) = 'if<(^OBJ)>'
             (^COMP-FORM) = if
             %ant = (s::(^OBJ) SIT)
             %cons = (s::(ADJUNCT ^) SIT)
             :$ (\P.(\Q.([],[P -> Q]))) :
                (%ant_t -o (%cons_t -o %cons_t)).

If CONJsub * (^ PRED) = 'if<(^OBJ)>'
             (^COMP-FORM) = if
             %ant = (s::(^OBJ) SIT)
             %cons = (s::(ADJUNCT ^) SIT)
             :$ (\P.(\Q.([],[P -> Q]))) :
                (%ant_t -o (%cons_t -o %cons_t)).

! 	  EXCL * (^ STMT-TYPE) = exclamation.


"negation"

not   NEG * @(PRED not)
            @(QUANT-SCOPE ^ %q)
            :$ (\P.([],[~(P)])) :
            (%q_t -o %q_t).

Not   NEG * @(PRED not)
            @(QUANT-SCOPE ^ %q)
            :$ (\P.([],[~(P)])) :
            (%q_t -o %q_t).

committee	  NMod * .

law 	  NMod * .

member	  NMod * ; ETC.

"nominal modifiers"

university NMod * .

at	  P * @(PREP at)
        @(PREP-SEM at).

"prepositions"
by 	  P * @(PREP by)
        {
        (^PTYPE) = sem
        @(PREP-SEM by) |
        (^PTYPE) = nosem }.

for 	  P * @(PREP for)
             @(PREP-SEM for).

from     P * @(PREP from)
            @(PREP-SEM from).

in 	  P * @(PREP in)
          @(PREP-SEM in).

of      P * @(PREP of)
            {@(PREP-SEM of) |
             (OBL-PART ^)}.

on 	  P * @(PREP on)
          @(PREP-SEM on).

outside	  P * @(PREP outside)
              @(PREP-SEM outside).

to 	  P * @(PREP to)
        {
        (^PTYPE) =c sem
        @(PREP-SEM to)};
	  PARTinf * (^ VFORM) =c inf.

with 	  P * @(PREP with)
	  @(PREP-SEM with).

within     P * @(PREP within)
                @(PREP-SEM within).


"punctuation, now with some functional information"

. 	  PERIOD * (^ STMT-TYPE) = declarative.


----
