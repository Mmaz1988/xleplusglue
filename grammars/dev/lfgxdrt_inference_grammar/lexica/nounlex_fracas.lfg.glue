NOUN ENGLISH LEXICON (1.0)


APCOM   N *     {@(PRED %stem) | (^ PRED) = '%stem<>(^SUBJ)'}
                (^NUM) = sg
                (^NTYPE NSYN) = proper
                (^NTYPE NSEM COMMON) = count
                @(PROPER-NOUN-SEM %stem)
                ;
        NMod *  (^ PRED) = 'APCOM'
        	            (^ TYPE) = kind.



Bill 	  N * {@(PRED %stem) | (^ PRED) = '%stem<>(^SUBJ)'}
              (^NUM) = sg
              (^GENDER) = masc
              (^NTYPE NSYN) = proper
              (^NTYPE NSEM PROPER) = name
               @(PROPER-NOUN-SEM %stem)
               @DEF-NAME.

Dumbo 	  N * {@(PRED %stem) | (^ PRED) = '%stem<>(^SUBJ)'}
                          (^NUM) = sg
                          (^NTYPE NSYN) = proper
                          (^NTYPE NSEM PROPER) = name
                          @(PROPER-NOUN-SEM %stem)
                          @DEF-NAME.

Eiffel     NMod *  (^ PRED) = 'Eiffel'
             	  (^ TYPE) = kind.




Europe     N *   @(PRED %stem)
                (^NUM) = sg
                (^NTYPE NSYN) = proper
                (^NTYPE NSEM PROPER) = location
                @(PROPER-NOUN-SEM %stem)
                @DEF-NAME.

European    N * {@(PRED %stem) | (^ PRED) = 'P<>(^SUBJ)'}
                (^NUM) = sg
                (^NTYPE NSYN) = common
                (^NTYPE NSEM COMMON) = count
                @(COUNT-NOUN-SEM %stem)
                ; ETC.
                    Europeans    N * @(PRED %stem)
                (^NUM) = pl
                (^NTYPE NSYN) = common
                (^NTYPE NSEM COMMON) = count
                @(COUNT-NOUN-SEM %stem).

Fido 	  N * {@(PRED %stem) | (^ PRED) = '%stem<>(^SUBJ)'}
                          (^NUM) = sg
                          (^NTYPE NSYN) = proper
                          (^NTYPE NSEM PROPER) = name
                          @(PROPER-NOUN-SEM %stem).
 
