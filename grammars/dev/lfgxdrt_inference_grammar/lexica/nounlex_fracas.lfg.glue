                (^NUM) = sg
                (^NTYPE NSYN) = proper
                (^NTYPE NSEM COMMON) = count
                @(PROPER-NOUN-SEM %stem)
                ;
	    NMod *  (^ PRED) = 'ITEL'
	            (^ TYPE) = kind.


ITEL-XZ   N *   {@(PRED %stem) | (^ PRED) = '%stem<>(^SUBJ)'}
                (^NUM) = sg
                (^NTYPE NSYN) = proper
                (^NTYPE NSEM COMMON) = count
                @(PROPER-NOUN-SEM %stem).

