                (^NTYPE NSEM COMMON) = count
                @(PROPER-NOUN-SEM %stem).



Karma  N * @(PRED %stem)
                (^NUM) = sg
                (^NTYPE NSYN) = proper
                (^NTYPE NSEM PROPER) = name
                @(PROPER-NOUN-SEM %stem)
                @DEF-NAME.

Kim 	  N * {@(PRED %stem) | (^ PRED) = '%stem<>(^SUBJ)'}
                          (^NUM) = sg
                          (^NTYPE NSYN) = proper
                          (^NTYPE NSEM PROPER) = name
                          @(PROPER-NOUN-SEM %stem)
