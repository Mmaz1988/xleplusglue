"comes: eg. 'comes cheap'"


come V-S XLE    (^PRED) = 'come<(^ SUBJ)(^PREDLINK)>'
                           @(EVENT come)
                           @(ARG1 (^ SUBJ)).

"to be"

"MOOD, PERF, PROG, PAST - theres templates for this"

"present: am(1sg), are(pl, 2sg, all person), is(3sg)  + aux is"

is   AUX[fin] *   @BE-TRANS-EV
                  @VPRESBE       "template without inf option"
		          @(PROG -_)
		          @(PERF -_)
		          @S-AGR;
	AUX[prog,fin] * @VPRESBE       "template without inf option"
	                @(PERF -_)
                    @S-AGR.

     "AUX * @(TENSE pres)
		    { (^ SUBJ PERS) = 1
                | (^ SUBJ PERS) = 3
                }
                (^ SUBJ NUM) = sg."

am   AUX[fin] *  @BE-TRANS-EV
                @VPRESBE
               @(PROG -_)
               @(PERF -_)
               (^SUBJ PERS) = 1
               (^SUBJ NUM) = sg.


are  AUX[fin] *   @BE-TRANS-EV
                  @VPRESBE
                  @(PROG -_)
                  @(PERF -_)
                  {(^ SUBJ NUM) = pl @(OT-MARK Be-3pl)|
                   (^ SUBJ PERS) = 2
	               (^ SUBJ NUM) = sg |
	               (^SUBJ PRON-TYPE) =c expl_
	               }.


"past: was(1sg, 3sg), were(pl, 2sg)  + aux was"

was   AUX[fin] *  @BE-TRANS-EV
           @VPAST
		   @(PROG -_)
		   @(PERF -_)
		   {@S-AGR
		   |
		   (^ SUBJ PERS) = 2
	       (^ SUBJ NUM) = sg};
       AUX[pass,fin] * @VPAST
       		           @S-AGR
       		           (^VFORM) = fin
       		           (^PASSIVE) =c +;
       AUX[prog,fin] * @VPAST
                      @S-AGR
                      @(PERF -_)
                      (^VFORM) = fin.


        "AUX * @(TENSE past)
            { @(PROG -_)
              @(PERF -_) |
             (^ TNS-ASP PROG)
            }
            { (^ SUBJ PERS) = 1
               | (^ SUBJ PERS) = 3
            }
            (^ SUBJ NUM) = sg."


were  AUX[fin]  *  @BE-TRANS-EV
            @VPAST
		   @(PROG -_)
		   @(PERF -_)
		   {(^ SUBJ NUM) = pl @(OT-MARK Be-3pl)|
		     (^ SUBJ PERS) = 2
	       (^ SUBJ NUM) = sg |
	        (^SUBJ PRON-TYPE) =c expl_ };
       AUX * @(TENSE past)
            { @(PROG -_)
              @(PERF -_) |
             (^ TNS-ASP PROG)
            }
            (^ SUBJ NUM) = pl.

"future"

will    AUX[fut,fin] * @VFUT "@(TENSE past)"
              "@(PROG -_)
              @(PERF -_)"
              (^ SUBJ NUM)
              (^ SUBJ PERS).
              "(^ VTYPE) = fin"
              "semantics don't work here"
"be, (being, been??)"

be   AUX[base] *  (^VFORM) = inf
                   @(PROG -_)
                   @(PERF -_)
                   @BE-TRANS-EV
             "|
              ^PRED) = 'be<(^PREDLINK)>(^SUBJ)'
              (^SUBJ) = (^ PREDLINK SUBJ)
              @(EVENT be)
              { @(ARG1 (^ PREDLINK)) | @(ARG1 (^ SUB J))}" "EX. There was an Italian vs. the dog was fast"
              ;
     AUX[prog,base] *  (^VFORM) = inf.



been     AUX[prog,base] *  (^VFORM) = inf.


                            "@(PERF +_)"


"modals"


can    AUX[modal,fin] *  (^PRED) = 'can<(^SUBJ)(^XCOMP)>'
                @(EVENT %stem)
                 %s = s::(^ XCOMP)
                 :$ (\P.(\S.(\v.(P@v + ([],[cont(v):S]))))) :
             	 (((s::^ EV)_v -o (s::^ EV)_t) -o ((%s SIT)_t -o ((s::^ EV)_v -o (s::^ EV)_t))),
              (^ XCOMP SUBJ) = (^SUBJ)
              (^ VFORM) = modal
              "s::^ = s::(^ XCOMP)"
              @(PROG -_)
              @(PERF -_)
              @VPRESMODAL.

could    AUX[modal,fin] *  (^PRED) = 'could<(^SUBJ)(^XCOMP)>'
                @(EVENT %stem)
                 %s = s::(^ XCOMP)
                 :$ (\P.(\S.(\v.(P@v + ([],[cont(v):S]))))) :
             	 (((s::^ EV)_v -o (s::^ EV)_t) -o ((%s SIT)_t -o ((s::^ EV)_v -o (s::^ EV)_t))),
              (^ XCOMP SUBJ) = (^SUBJ)
              (^ VFORM) = modal
              "s::^ = s::(^ XCOMP)"
              @(PROG -_)
              @(PERF -_)
              @VPRESMODAL.

would    AUX[modal,fin] *  (^PRED) = 'would<(^SUBJ)(^XCOMP)>'
                @(EVENT %stem)
                 %s = s::(^ XCOMP)
                 :$ (\P.(\S.(\v.(P@v + ([],[cont(v):S]))))) :
             	 (((s::^ EV)_v -o (s::^ EV)_t) -o ((%s SIT)_t -o ((s::^ EV)_v -o (s::^ EV)_t))),
              (^ XCOMP SUBJ) = (^SUBJ)
              (^ VFORM) = modal
              "s::^ = s::(^ XCOMP)"
              @(PROG -_)
              @(PERF -_)
              @VPRESMODAL.

should    AUX[modal,fin] *  (^PRED) = 'should<(^SUBJ)(^XCOMP)>'
                @(EVENT %stem)
                 %s = s::(^ XCOMP)
                 :$ (\P.(\S.(\v.(P@v + ([],[cont(v):S]))))) :
             	 (((s::^ EV)_v -o (s::^ EV)_t) -o ((%s SIT)_t -o ((s::^ EV)_v -o (s::^ EV)_t))),
              (^ XCOMP SUBJ) = (^SUBJ)
              (^ VFORM) = modal
              "s::^ = s::(^ XCOMP)"
              @(PROG -_)
              @(PERF -_)
              @VPRESMODAL.


did AUX[fin] * @VPAST;
  "Not sure if do support can appear in a nonfinite clause"
    AUXdo * @VPAST.

does AUXdo * @(TENSE pres)
	         @(MOOD indicative).

"For perfect forms"

had AUX[perf,fin] * @(TENSE past)
                     @(MOOD indicative).

has AUX[perf,fin] * @(TENSE pres)
                    @(MOOD indicative).

have AUX[perf,base] * (^VFORM) = inf;
     V-S XLE @(TRANS-EV %stem).


"did       V-S XLE @(INTRANS-EV %stem)."

