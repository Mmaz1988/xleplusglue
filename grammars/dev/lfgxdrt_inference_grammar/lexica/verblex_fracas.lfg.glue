"take 	V-S XLE @(TRANS-EV %stem)."

"take` part V-S XLE @(INTRANS-EV %stem)."

takes` part V[fin] * {@(INTRANS-EV %stem) | @(VERB-SUBJ-OBL-EV %stem) }
                @(PROG -_)
                @(PERF -_)
                @S-AGR
                @(VPRES)
                (^VFORM) = fin.

take` part V[base] * {@(INTRANS-EV %stem) | @(VERB-SUBJ-OBL-EV %stem) }
                      @(PROG -_)
                      @(PERF -_)
                      (^VFORM) = inf;
           V[fin] * {@(INTRANS-EV %stem) | @(VERB-SUBJ-OBL-EV %stem) }
                        @(PROG -_)
                        @(PERF -_)
                        (^TNS-ASP TENSE) = pres
                        (^VFORM) = fin.



"use: either 'to use smth' or 'used to xyz'"

use     V-S XLE { @(TRANS-EV %stem) |
                    (^PRED) = '%stem<(^XCOMP)>(^SUBJ)'
                    (^ XCOMP SUBJ) = (^SUBJ)
                    (^TNS-ASP TENSE) =c past}.


visit V-S XLE @(TRANS-EV %stem).

