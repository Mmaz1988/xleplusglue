// Pragmatics core: shared hierarchies and templates, and the rules every later
// pragmatics file builds on (syntax-semantics linking, coarguments). List it first.

// HIERARCHIES

//Functional hierarchy
GF ::= SUBJ > OBJ > OBJ2 > OBL > OBL-COMP > PREDLINK .

//Templates
GF := SUBJ | OBJ | OBL | OBL-COMP | ADJUNCT | PREDLINK .

DRS := IMP | NOT | MERGE | UPDATE | SUB | SCOPE .

//Link DRs to their originating GFs
DR-GF-LINK(#a, #d) := #a NODE_TYPE 'referent' & #a SRC %a & #b SYN-ID %b & %a == %b & #b ^(in_set>GLUE>g::>cproj) #c phi #d .

//Coargument path
COARG-PATH(#a,#b,#c) := #a ^(@GF*:~(->PRED)) #b ^(@GF) #c.

COARG(#a,#b) := @COARG-PATH(#a,#r,#s) & #s !(@GF) #b & id(#a) != id(#b).

//States a referent's state is evaluated in: its parents, a p-box's host included
CONTEXT := IMP | NOT | MERGE | UPDATE | SUB | SCOPE | PRSP .

DR-PRECEDENCE(#b,#d) := #a IN #b NAME %a & #b NODE_TYPE referent &
                        #c IN #d NAME %b & #d NODE_TYPE referent &
                        #c ^(@CONTEXT*) #e & #a !(POTENTIAL-ACC*) #e &
                        id(#c) != id(#e) &
                        #a NAME %s & #c NAME %t & id(%s) < id(%t) .

//id(%a) < id(%b).

DR-SEM(#a,#b) := #a SYNSEM #c s:: #b.

// RULES

//Connects referents via SRC with syntactic indices via SYN-ID
@DR-GF-LINK(#a,#d) ==> #a SYNSEM #d.

@COARG(#a,#b) ==> #a COARG #b.
