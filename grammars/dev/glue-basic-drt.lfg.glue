GLUE   BASIC   CONFIG (1.0)
  ROOTCAT   CP.
  FILES  .
  LEXENTRIES   (ENGLISH BASIC).
  RULES   (ENGLISH BASIC).
  TEMPLATES (ENGLISH BASIC) (GLUE BASIC).
  GOVERNABLERELATIONS    SUBJ OBJ OBJ-TH OBJ?+ OBL?+ COMP XCOMP.
  SEMANTICFUNCTIONS    ADJUNCT TOPIC FOCUS.
  NONDISTRIBUTIVES    NUM PERS.
  EPSILON   e.
  CHARACTERENCODING utf-8.
OPTIMALITYORDER NOGOOD.

----

"glue-basic-drt.lfg requires the following settings in xlerc: semParser 2, processDRT 1"

"AVM representations of meaning constructors appear as members of the GLUE set at f-structure."

ENGLISH   BASIC   RULES (1.0)

   CP --> C'.

   C' --> (C)
 	  IP.

   C =   Comp.

   IP --> (NP: (^ SUBJ) = !)
 	  I'.

   I' --> (I)
 	  VP.

   I = Aux.

   VP --> V'.

   V' --> (V)
 	  (NP: (^ OBJ) = !)
 	  (NP: (^ OBJ-TH) = !)
 	  (PP: (^ OBL) = !)
 	  (CP: (^ COMP) = !).

   NP -->   {
            ({D |
            PRON: (^ PRON-TYPE) =c poss })
 	        N'
 	        |
 	        PRON: (^ PRON-TYPE) ~= poss
 	        }.

   N' --> (Adj: ! $ (^ ADJ))
 	  N.

   PP --> P
          NP: (^ OBJ) = !.

----

ENGLISH   BASIC   LEXICON (1.0)

"Complementizer"

  that 	  Comp * (^ COMPFORM) = 'that'.

"Nouns"

  David   N * @(NAME david).

  Chris   N * @(NAME chris).

  Tracy   N * @(NAME tracy).

  Kim   N * @(NAME kim).

  man 	  N * @(NOUN man).

  woman   N * @(NOUN woman).

  book 	  N * @(NOUN book).

  person  N * @(NOUN person).

he 	  PRON * @(PRON he 3 sg pers)
		 @(CASE nom)
		 @(QUANT-SCOPE ^ %s)
         @(NP-INDEX %n)
         :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
          ((%n_e -o %n_t) -o ((%n_e -o %s_t) -o %s_t)) || insitu,
         :$ (\x.([],[ant(x)])) : (%n_e -o %n_t).

she 	  PRON * @(PRON she 3 sg pers)
		 @(CASE nom).

it	  PRON * @(PRON it 3 sg pers).

we 	  PRON * @(PRON we 1 pl pers)
		 @(CASE nom).

us 	  PRON * @(PRON us 1 pl pers)
		 @(CASE acc).

they 	  PRON * @(PRON they 3 pl pers)
		 @(CASE nom).

them 	  PRON * @(PRON them 3 pl pers)
		 @(CASE acc).

my	PRON * @(PRON my 1 sg poss).

her	PRON * @(PRON her 3 sg poss).

him 	  PRON * @(PRON he 3 sg pers)
		 @(CASE acc)
		 @(QUANT-SCOPE ^ %s1)
         @(NP-INDEX %n1)
         :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
          ((%n1_e -o %n1_t) -o ((%n1_e -o %s1_t) -o %s1_t)) || insitu,
         :$ (\x.([],[ant(x)])) : (%n1_e -o %n1_t).

herself  PRON * @(PRON 3 sg fem refl).

himself  PRON * @(PRON himself 3 sg refl)
                (^ GEND) = masc
                 @(QUANT-SCOPE ^ %s)
                 @(NP-INDEX %n)
                 :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
                 ((%n_e -o %n_t) -o ((%n_e -o %s_t) -o %s_t)) || insitu,
                 :$ (\x.([],[ant(x)])) : (%n_e -o %n_t).





"Determiners"

     "Quantifier"

     a 	  D * (^ SPEC PRED) = 'a'
              (s::^ INDEX) = %index
              @(QUANT-SCOPE ^ %s)
     	      :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
     	      ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)).

     the 	  D * (^ SPEC PRED) = 'the'
              (s::^ INDEX) = %index
              @(QUANT-SCOPE ^ %s)
          	  :$ (\P.(\Q.p(([x],[bind(x)]) + P@x) + Q@x)) :
          	  ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)) || noscope.

     every 	D * (^ SPEC PRED) = 'every'
                (s::^ INDEX) = %index
               @(QUANT-SCOPE ^ %s)
     	      :$ (\P.(\Q.([],[([x],[]) + P@x -> Q@x]))) :
     	      ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)).

     everyone 	N * (^ PRED) = 'everyone'
            	  (s::^ INDEX) = %index
          	      @(QUANT-SCOPE ^ %s)
                  :$ (\P.(\Q.([],[([x],[]) + P@x -> Q@x]))) :
                  ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)),
          	      :$ (\x.([],[person(x)])) : (s::^_e -o s::^_t).




"Verbs"

  yawned  V * @(VERB-SUBJ yawn)
	          @VPAST.

  smiled  V * @(VERB-SUBJ smile)
	          @VPAST.

  saw 	  V * @(VERB-SUBJ-OBJ see)
	          @VPAST.

  gave    V * @(VERB-SUBJ-OBJ-OBJ2 give)
              @VPAST.


  told     V * @(VERB-SUBJ-OBJ-OBL told)
               @(VPAST).

  thought V * @(VERB-SUBJ-COMP think)
              @VPAST.

  said V * @(VERB-SUBJ-COMP think)
                @VPAST.

"Adjectives"

  interesting Adj * (^ PRED) = 'interesting'.



"Prepositions"

about 	  P * @(PREP about).


----

ENGLISH   BASIC   TEMPLATES (1.0)

  PRON(P Z N T) = (^ PRED) = 'P'
  	  (^ NUM) = N
  	  (^ PERS) = Z
  	  (^ PRON-TYPE) = T
  	  (^ NTYPE) = pron.

  PREP(P) =   (^ PRED) = 'P<(^OBJ)>'
              (^ PFORM) = P.

   "Templates for argument structure. Need to be separate to avoid trouble with local names"
   ARG1(ARG) =
        %EV = (s::^ EV)
       :$ (\V.(\x.(\e.(V@e + ([],[arg1(e,x)]))))) :
       ((%EV_v -o %EV_t) -o (s::ARG_e -o (%EV_v -o %EV_t))) || noscope.

   ARG2(ARG) =
       %EV = (s::^ EV)
       :$ (\V.(\x.(\e.(V@e + ([],[arg2(e,x)]))))) :
       ((%EV_v -o %EV_t) -o (s::ARG_e -o (%EV_v -o %EV_t))) || noscope.

   ARG3(ARG) =
       %EV = (s::^ EV)
       :$ (\V.(\x.(\e.(V@e + ([],[arg3(e,x)]))))) :
       ((%EV_v -o %EV_t) -o (s::ARG_e -o (%EV_v -o %EV_t))) || noscope.

"Nouns"

NOUN(P) = (^ PRED) = 'P'
      :$ (\x.([],[%stem(x)])) : (s::^_e -o s::^_t).

NAME(P) = (^ PRED) = 'P'
      @(QUANT-SCOPE ^ %s)
      (s::^ INDEX) = %index
      :$ (\x.([],[x=%stem])) : (s::^_e -o s::^_t),
      :$ (\Q.(\R.([x],[]) + Q@x + R@x)) :
      ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)) || insitu.

CASE(C) = (^ CASE) = C.

"Verbs"

   VERB-SUBJ(P) =
	  (^ PRED) = 'P<(^ SUBJ)>'
	  @(EVENT P)
	  @(ARG1 (^SUBJ)).

   VERB-SUBJ-OBJ(P) =
	  (^ PRED) = 'P<(^ SUBJ)(^ OBJ)>'
	   @(EVENT P)
	  @(ARG1 (^SUBJ))
	  @(ARG2 (^OBJ)).


    VERB-SUBJ-OBJ-OBJ2(P) =
        (^ PRED) = 'P<(^ SUBJ)(^ OBJ)(^ OBJ-TH)>'
         @(EVENT P)
        @(ARG1 (^SUBJ))
        @(ARG2 (^OBJ))
        @(ARG3 (^OBJ-TH)).


       VERB-SUBJ-OBJ-OBL(P) =
           (^ PRED) = 'P<(^ SUBJ)(^ OBJ)(^ OBL)>'
            @(EVENT P)
           @(ARG1 (^SUBJ))
           @(ARG2 (^OBJ))
           @(ARG3 (^OBL)).



    VERB-SUBJ-COMP(P) =
        (^ PRED) = 'P<(^ SUBJ)(^ COMP)>'
        @(EVENT P)
        @(ARG1 (^SUBJ))
        %s = s::(^ COMP)
        :$ (\Q.(\S.(\e.(Q@e + ([],[cont(e):S]))))) :
        (((s::^ EV)_v -o (s::^ EV)_t) -o (%s_t -o ((s::^ EV)_v -o (s::^ EV)_t))) || noscope.




   VPAST = (^ VTYPE) = FIN
	  (^ TENSE) = PST.


----

GLUE   BASIC   TEMPLATES (1.0)

   LLIMP(N L R) = (N ANT) = L
	  (N CONS) = R.

   LLATOM(N L T) = (N RESOURCE) = L
	  (N TYPE) = T.

    LLQUANT(N B) = (N BINDER) = B.

    LLCLOSURE(G) = G $ (g::* GLUE).

   GLUE-MEANING(R M) =
	  (R MEANING) = M.

  NOSCOPE(G) = (G NOSCOPE) = +.
  INSITU(G) = (G INSITU) = +.

   QUANT-SCOPE(UP NAME) =
   %name = ({SUBJ | OBJ | OBJ-TH | XCOMP | COMP | OBL-TO | OBL-AG | OBL | ADJUNCT | $}+ ^)
   (%name TENSE)
   NAME = s::%name.


  NP-INDEX(NP) = { ~(OBL OBJ ^)
                    NP = s::^ |
                    (OBL OBJ ^)
                    NP = s::(OBJ ^)}.

   EVENT(P) =  %EV = (s::^ EV)
              (s::^ INDEX) = %index
           :$ (\e.([],[P(e)])) :
           (%EV_v -o %EV_t),
           :$ (\Q.([e],[]) + Q@e) :
           ((%EV_v -o %EV_t) -o s::^_t).

----
