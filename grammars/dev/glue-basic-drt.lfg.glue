GLUE   BASIC   CONFIG (1.0)
  ROOTCAT   CP.
  FILES  .
  LEXENTRIES   (ENGLISH BASIC).
  RULES   (ENGLISH BASIC).
  TEMPLATES (ENGLISH BASIC) (GLUE BASIC).
  GOVERNABLERELATIONS    SUBJ OBJ OBJ-TH OBJ?+ OBL OBL-?+ COMP XCOMP.
  SEMANTICFUNCTIONS    ADJUNCT TOPIC FOCUS.
  NONDISTRIBUTIVES    NUM PERS.
  EPSILON   e.
  CHARACTERENCODING utf-8.
OPTIMALITYORDER NOGOOD.

----

"glue-basic-drt.lfg requires the following settings in xlerc: semParser 2, processDRT 1"

"AVM representations of meaning constructors appear as members of the GLUE set at f-structure."

ENGLISH   BASIC   RULES (1.0)

   CP --> { C'
            | CP PERIOD
            | @(CP-COORD CP)
            | CPcond: ! $ (^ ADJ); (COMMA) C' }.

    CPcond --> Cond CP: (^OBJ) = !.

   C' --> (C)
 	  IP.

   C =   Comp.

   IP --> (NP: (^ SUBJ) = !)
 	  I'.

   I' --> (I)
 	  VP.

   I = Aux.

   VP --> V'.

   V' --> (V)
 	  (NP: (^ OBJ) = !)
 	  (NP: (^ OBJ-TH) = !)
 	  (PP: (^ OBL) = !)
 	  (CP: (^ COMP) = !).

   NP -->   {
            ({D |
            PRON: (^ PRON-TYPE) =c poss })
 	        N'
 	        |
 	        PRON: (^ PRON-TYPE) ~= poss
 	        }.

   N' --> (Adj: ! $ (^ ADJ))
 	  N.

   PP --> P
          NP: (^ OBJ) = !.

  CP-COORD(CAT) = CAT: ! $ ^;
            PERIOD
            CAT: ! $ ^;
            PERIOD .






----

ENGLISH   BASIC   LEXICON (1.0)

"Complementizer"

  that 	  Comp * (^ COMPFORM) = 'that'.

  if Cond * (^ PRED) = 'if<(^OBJ)>'
            %ant = s::(^OBJ)
            %cons = s::(ADJ $ ^)
            :$ (\P.(\Q.([],[P -> Q]))) :
            (%ant_t -o (%cons_t -o %cons_t)).

  to Aux * (^ VFORM) =c inf.

  had Aux * (^ VFORM) =c perf.

  "or make this an aux?"
  would V *   (^ PRED) = 'P<(^ SUBJ)(^ XCOMP)>'
                (^ VFORM) = modal
                @(ARG1 (^SUBJ))
                (^ XCOMP SUBJ) = (^SUBJ)
                @(EVENT P).

"Nouns"

  Alan N * @(NAME alan).

  Bertie   N * @(NAME bertie).

  David   N * @(NAME david).

  Chris   N * @(NAME chris).

  John N * @(NAME john).

  Kim   N * @(NAME kim).

  Mary N * @(NAME mary).

  Tracy   N * @(NAME tracy).

  man 	  N * @(NOUN man).

  woman   N * @(NOUN woman).

  book 	  N * @(NOUN book).

  person  N * @(NOUN person).

  friend N * @(NOUN friend) (^ NUM) = sg.

  candidate  N * @(NOUN candidate).

  linguist  N * @(NOUN linguist).

  problem N * @(NOUN problem).

  snake N * @(NOUN snake).


who PRON * (^PRON-TYPE) = rel
             (^PRED) = 'who'
             {(^NUM) =sg |(^NUM) = pl}.

he 	  PRON * @(PRON-GEND he male 3 sg pers)
		 @(CASE nom)
         (^ GEND) = masc.

she 	  PRON * @(PRON-GEND she female 3 sg pers)
		 @(CASE nom).

it	  PRON * @(PRON it 3 sg pers)
             (^GEND) = neut.

we 	  PRON * @(PRON we 1 pl pers)
		 @(CASE nom).

us 	  PRON * @(PRON us 1 pl pers)
		 @(CASE acc).

they 	  PRON * @(PRON they 3 pl pers)
		 @(CASE nom).

them 	  PRON * @(PRON them 3 pl pers)
		 @(CASE acc).

my	PRON * @(PRON-GEND my 1 sg poss).

her	PRON * @(PRON-GEND her male 3 sg poss)
           (^GEND) = fem.

him 	  PRON * @(PRON-GEND he male 3 sg pers)
		  @(CASE acc)
		  (^ GEND) = masc.

herself  PRON * @(PRON-GEND female 3 sg fem refl)
                (^GEND) = fem.

himself  PRON * @(PRON-GEND himself male 3 sg refl)
                (^ GEND) = masc.





"Determiners"

     "Quantifier"

     a 	  D * (^ SPEC PRED) = 'a'
              @(QUANT-SCOPE ^ %s)
              @(NP-INDEX %n)
     	      :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
     	      ((%n_e -o %n_t) -o ((%n_e -o %s_t) -o %s_t)).

     the 	  D * (^ SPEC PRED) = 'the'
              @(QUANT-SCOPE ^ %s)
          	  :$ (\P.(\Q.p(([x],[bind(x)]) + P@x) + Q@x)) :
          	  ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)) || noscope.

     every 	D * (^ SPEC PRED) = 'every'
               @(QUANT-SCOPE ^ %s)
     	      :$ (\P.(\Q.([],[([x],[]) + P@x -> Q@x]))) :
     	      ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)).

     everyone 	N * (^ PRED) = 'everyone'
          	      @(QUANT-SCOPE ^ %s)
                  :$ (\P.(\Q.([],[([x],[]) + P@x -> Q@x]))) :
                  ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)),
          	      :$ (\x.([],[person(x)])) : (s::^_e -o s::^_t).




"Verbs"

  yawned  V * @(VERB-SUBJ yawn)
	          @VPAST.

  arrived V * @(VERB-SUBJ arrive)
	          @VPAST.

 sat V * @(VERB-SUBJ sit)
	          @VPAST.

  introduced    V * @(VERB-SUBJ-OBJ-OBL introduce)
               @VPAST.

  leave V * @(VERB-SUBJ leave) (^ VFORM) = inf.

  win V * @(VERB-SUBJ win) (^ VFORM) = inf.

  appeared V * @(VERB-SUBJ appear)
	          @VPAST.

  smiled  V * @(VERB-SUBJ smile)
	          @VPAST.

   was 	  V * @(VERB-SUBJ-OBJ be)
	          @VPAST.

  liked V * @(VERB-SUBJ-OBJ like)
	          @VPAST.

  likes V * @(VERB-SUBJ-OBJ like)
	          @VPRES.

  solved V * @(VERB-SUBJ-OBJ solve)
	          @VPAST.

  saw 	  V * @(VERB-SUBJ-OBJ see)
	          @VPAST.

  seen V *  @(VERB-SUBJ-OBJ see)
	          @VPAST
	          (^VFORM) = perf.

  supports	  V * @(VERB-SUBJ-OBJ support)
	          @VPRES.

  has	  V * @(VERB-SUBJ-OBJ have)
	          @VPRES.

  talk   V * {@(VERB-SUBJ-OBL talk) |@(VERB-SUBJ talk) }
	          (^ VFORM) = inf.

  gave    V * @(VERB-SUBJ-OBJ-OBJ2 give)
              @VPAST.


  told     V * @(VERB-SUBJ-OBJ-OBL told)
               @VPAST.

  thought V * @(VERB-SUBJ-COMP think)
              @VPAST.

  knew V * @(VERB-SUBJ-COMP know)
              @VPAST.

  said V * @(VERB-SUBJ-COMP say)
              @VPAST.

  wanted V * {@(VERB-SUBJ-XCOMP want) | @(VERB-SUBJ-OBJ-XCOMP want)}
              @VPAST.

"Adjectives"

  interesting Adj * (^ PRED) = 'interesting'.

  difficult Adj * (^PRED) = 'difficult'.

  down Adv * (^PRED) = 'down'.



"Prepositions"

about 	  P * @(PREP about).

near      P * @(PREP near).

to    P * @(PREP to).



""

. PERIOD *   .


, COMMA *   .
----

ENGLISH   BASIC   TEMPLATES (1.0)

  PRON-GEND(P G Z N T) = (^ PRED) = 'P'
  	  (^ NUM) = N
  	  (^ PERS) = Z
  	  (^ PRON-TYPE) = T
  	  (^ NTYPE) = pron
  	  @(PRON-SEM-GEND G).

    PRON(P Z N T) = (^ PRED) = 'P'
    	  (^ NUM) = N
    	  (^ PERS) = Z
    	  (^ PRON-TYPE) = T
    	  (^ NTYPE) = pron
    	  @(PRON-SEM).

  PRON-SEM-GEND(G) = (s::^ INDEX) = %index
                  @(QUANT-SCOPE ^ %s)
                  @(NP-INDEX %n)
                 :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
                  ((%n_e -o %n_t) -o ((%n_e -o %s_t) -o %s_t)) || insitu,
                  :$ (\x.([],[ant(x),G(x)])) : (%n_e -o %n_t).

    PRON-SEM = (s::^ INDEX) = %index
                   @(QUANT-SCOPE ^ %s)
                   @(NP-INDEX %n)
                   :$ (\P.(\Q.([x],[]) + P@x + Q@x)) :
                    ((%n_e -o %n_t) -o ((%n_e -o %s_t) -o %s_t)) || insitu,
                    :$ (\x.([],[ant(x)])) : (%n_e -o %n_t).

  PREP(P) =   (^ PRED) = 'P<(^OBJ)>'
              (^ PFORM) = P.

   "Templates for argument structure. Need to be separate to avoid trouble with local names"
   ARG1(ARG) =
        %EV = (s::^ EV)
       :$ (\V.(\x.(\e.(V@e + ([],[arg1(e,x)]))))) :
       ((%EV_v -o %EV_t) -o (s::ARG_e -o (%EV_v -o %EV_t))) || noscope.

   ARG2(ARG) =
       %EV = (s::^ EV)
       :$ (\V.(\x.(\e.(V@e + ([],[arg2(e,x)]))))) :
       ((%EV_v -o %EV_t) -o (s::ARG_e -o (%EV_v -o %EV_t))) || noscope.

   ARG3(ARG) =
       %EV = (s::^ EV)
       :$ (\V.(\x.(\e.(V@e + ([],[arg3(e,x)]))))) :
       ((%EV_v -o %EV_t) -o (s::ARG_e -o (%EV_v -o %EV_t))) || noscope.

   CLAUSAL-ARG(ARG) =
   :$ (\Q.(\S.(\e.(Q@e + ([],[cont(e):S]))))) :
           (((s::^ EV)_v -o (s::^ EV)_t) -o (s::ARG_t -o ((s::^ EV)_v -o (s::^ EV)_t))) || noscope.

"Nouns"

NOUN(P) = (^ PRED) = 'P'
          @(NP-INDEX %n)
         :$ (\x.([],[%stem(x)])) : (%n_e -o %n_t).

NAME(P) = (^ PRED) = 'P'
      @(QUANT-SCOPE ^ %s)
      :$ (\x.([],[x=%stem])) : (s::^_e -o s::^_t),
      :$ (\Q.(\R.([x],[]) + Q@x + R@x)) :
      ((s::^_e -o s::^_t) -o ((s::^_e -o %s_t) -o %s_t)) || insitu.

CASE(C) = (^ CASE) = C.

"Verbs"

   VERB-SUBJ(P) =
	  (^ PRED) = 'P<(^ SUBJ)>'
	  @(EVENT P)
	  @(ARG1 (^SUBJ)).

   VERB-SUBJ-OBJ(P) =
	  (^ PRED) = 'P<(^ SUBJ)(^ OBJ)>'
	  @(EVENT P)
	  @(ARG1 (^SUBJ))
	  @(ARG2 (^OBJ)).


    VERB-SUBJ-OBJ-OBJ2(P) =
        (^ PRED) = 'P<(^ SUBJ)(^ OBJ)(^ OBJ-TH)>'
        @(EVENT P)
        @(ARG1 (^SUBJ))
        @(ARG2 (^OBJ))
        @(ARG3 (^OBJ-TH)).

    VERB-SUBJ-OBL(P) =
	   (^ PRED) = 'P<(^ SUBJ)(^ OBL)>'
	   @(EVENT P)
	   @(ARG1 (^SUBJ))
	   @(ARG2 (^OBL)).

       VERB-SUBJ-OBJ-OBL(P) =
           (^ PRED) = 'P<(^ SUBJ)(^ OBJ)(^ OBL)>'
            @(EVENT P)
           @(ARG1 (^SUBJ))
           @(ARG2 (^OBJ))
           @(ARG3 (^OBL)).



    VERB-SUBJ-COMP(P) =
        (^ PRED) = 'P<(^ SUBJ)(^ COMP)>'
        @(EVENT P)
        @(ARG1 (^SUBJ))
        @(CLAUSAL-ARG (^ COMP)).

    VERB-SUBJ-XCOMP(P) =
        (^ PRED) = 'P<(^ SUBJ)(^ XCOMP)>'
        (^ XCOMP SUBJ) = (^SUBJ)
        @(EVENT P)
        @(ARG1 (^SUBJ))
        @(CLAUSAL-ARG (^ XCOMP)).

   VERB-SUBJ-OBJ-XCOMP(P) =
        (^ PRED) = 'P<(^ SUBJ)(^OBJ)(^ XCOMP)>'

        (^ XCOMP SUBJ) = (^OBJ)
       @(EVENT P)
       @(ARG1 (^SUBJ))
       @(ARG2 (^OBJ))
       @(CLAUSAL-ARG (^ XCOMP)).


   VPAST = (^ VTYPE) = FIN
	  (^ TENSE) = PST.

VPRES = (^ VTYPE) = FIN
	  (^ TENSE) = PRES.

----

GLUE   BASIC   TEMPLATES (1.0)

   LLIMP(N L R) = (N ANT) = L
	  (N CONS) = R.

   LLATOM(N L T) = (N RESOURCE) = L
	  (N TYPE) = T.

    LLQUANT(N B) = (N BINDER) = B.

    LLCLOSURE(G) = G $ (g::* GLUE).

   GLUE-MEANING(R M) =
	  (R MEANING) = M.

  NOSCOPE(G) = (G NOSCOPE) = +.
  INSITU(G) = (G INSITU) = +.

   QUANT-SCOPE(UP NAME) =
   %name = ({SUBJ | OBJ | OBJ-TH | XCOMP | COMP | OBL-TO | OBL-AG | OBL | ADJUNCT | $}+ ^)
   (%name TENSE)
   NAME = s::%name.


  NP-INDEX(NP) = { ~(OBL OBJ ^)
                    NP = s::^ |
                    (OBL OBJ ^)
                    NP = s::(OBJ ^)}.

   EVENT(P) =  %EV = (s::^ EV)
           :$ (\e.([],[P(e)])) :
           (%EV_v -o %EV_t),
           :$ (\Q.([e],[]) + Q@e) :
           ((%EV_v -o %EV_t) -o s::^_t).

----
